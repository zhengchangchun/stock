# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.iml

# Environment
.env
.env.local
.env.*.local

# Python venv
.venv/
venv/

# 项目数据（SQLite / 缓存 / 备份）
# 必须用根锚定 `/data/`：裸 `data/` 会连 Python 包 `stocklab/data/` 一起忽略，
# 导致该包的源码无法提交（见 ERROR_DIARY 2026-09-14「gitignore 裸 data/ 吞掉源码包」）。
/data/
/reports/

# 测试与工具缓存
.pytest_cache/
.ruff_cache/

# Build
dist/
build/
*.tsbuildinfo

# Dependencies
node_modules/
vendor/
__pycache__/
*.pyc

# Logs
*.log

# Claude Code - local/user-specific (keep skills symlink)
.claude/settings.local.json
.claude/scheduled_tasks.json
.claude/session-state/

# nanobot - 本地工具调用回执（agent 运行时 scratch，不是项目产物）
.nanobot/

# SDD 工作区（superpowers:subagent-driven-development 的临时区：
# 台账 / task brief / 实现者报告 / review diff 包）
# 属本地进程间协作的 scratch，不是项目产物；方案收尾时整体删除，git 历史才是记录。
.superpowers/
